# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib

# Test binary, built with `go test -c`
*.test

# Output of the go coverage tool, specifically when used with LiteIDE
*.out

# Dependency directories (remove the comment below to include it)
# vendor/

# Go workspace file
go.work

# Local build outputs
/gogator
/dist/
/build/

# Private local data. Keep only sample data in the repo.
sites.local.csv
routes.local.csv
*_processed.csv
*_expanded.csv
*_jitter.csv
*_jitter_same_site.csv
*_route_observations.csv
*_route_anomalies.csv
*_audit.csv

